# Copy this file to .env and fill in real keys to switch the app out of mock mode.
# Never commit the real .env file to version control - it holds live API keys.

# Story text (generation + character-photo vision) - via OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Translation - via Gemini instead of OpenAI by default. Get a key at
# https://aistudio.google.com/apikey . Leave blank to run translation in
# mock mode (story generation/images stay live if their own keys are set).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Set to "openai" to run translation through OpenAI instead of Gemini (uses
# OPENAI_API_KEY/OPENAI_MODEL above, no separate key needed) - useful if you'd
# rather depend on a single LLM provider for everything. Leave as "gemini"
# (or unset) to keep the default.
TRANSLATION_PROVIDER=gemini

# 3D cartoon images - the spec names an API at "Deepak.org", which does not
# appear to be a real, public service. This app targets the closest real
# match, DeepAI (https://deepai.org), by default. If you have a different
# concrete "Deepak.org" endpoint, set DEEPAI_BASE_URL to it - the request
# shape (api-key header + "text" field, JSON response with output_url) is
# in story_engine/image_client.py and can be adjusted there if the real
# service's contract differs.
DEEPAI_API_KEY=
DEEPAI_BASE_URL=https://api.deepai.org/api/text2img

# Selling image credits ($5 for 50) via Stripe Checkout - a Stripe-hosted
# payment page, so this app never touches card details. Get keys at
# https://dashboard.stripe.com/apikeys - use the "sk_test_..." key first and
# Stripe's test card 4242 4242 4242 4242 (any future expiry, any CVC) to try
# the whole flow for free before ever using a live "sk_live_..." key.
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you register in the
# Stripe dashboard pointing at this app's /api/stripe/webhook - see
# DEPLOY.md's "Selling credits with Stripe" section for the full walkthrough.
# Leave both blank to run "Add credits" as a free mock top-up instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set to 1 to force mock mode even if keys above are present (handy for demos).
FORCE_MOCK=0

# In production behind nginx (see deploy/nginx_kertoons.conf), leave HOST as
# 127.0.0.1 so the app is only reachable through the reverse proxy, never
# directly on the internet.
HOST=127.0.0.1
PORT=8765

# The app's own absolute public URL - required once STRIPE_SECRET_KEY is set
# (Stripe Checkout needs absolute success/cancel URLs to redirect back to).
# Leave blank for local dev (defaults to http://HOST:PORT). If mounted under
# an existing site's subpath (see DEPLOY.md), include that path, e.g.
# PUBLIC_BASE_URL=https://kertoons.com/story
PUBLIC_BASE_URL=

# Set both to auto-create an admin account on startup (safe to leave set
# across restarts - a no-op once that username already exists). Grants
# access to the admin panel (user management, coupon codes, reports) at
# /admin.html. Leave either blank to disable the admin panel entirely.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test123

# Optional, separate, MORE privileged account - set both to auto-create a
# superadmin on startup, same "blank disables it" convention as above. Use
# a DIFFERENT username from ADMIN_USERNAME. Grants access to a single
# unlinked page, /superadmin.html (not in any nav menu - reach it by typing
# the URL directly), showing per-image and server-fee cost settings that
# even regular admins can't see or edit.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
